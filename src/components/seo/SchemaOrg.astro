---
import { site } from "@/data/site";

const taxIdentifier = "";

const schema: Record<string, any> = {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: site.info.name,
    legalName: site.info.name,
    image: new URL("/og-image.png", Astro.site || site.info.url).href,
    telephone: site.contact.phone,
    email: site.contact.email,
    url: site.info.url,
    description: site.info.description,
    address: {
        "@type": "PostalAddress",
        addressLocality: site.data.addressLocality,
        addressRegion: site.data.addressRegion,
        addressCountry: "BR",
    },
    areaServed: site.cities.map((city) => ({
        "@type": "AdministrativeArea",
        name: city.name,
        description: city.description,
    })),
    sameAs: [
        site.socials.instagram,
        site.socials.github,
        site.socials.linkedin,
    ].filter(Boolean),
};

if (taxIdentifier) {
    schema.taxID = taxIdentifier;
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
