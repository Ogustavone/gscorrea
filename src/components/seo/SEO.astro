---
import { site } from "@/data/site";
import SchemaOrg from "./SchemaOrg.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    canonical?: string;
    noindex?: boolean;
}

const {
    title = site.info.fullName,
    description = site.info.description,
    image = "/og-image.png",
    imageAlt = title,
    canonical = Astro.url.pathname,
    noindex = false,
} = Astro.props;

// Construção de URLs absolutas
const canonicalURL = new URL(canonical, Astro.site || site.info.url);
const imageURL = new URL(image, canonicalURL);

// Pega a primeira cidade da sua lista de atendimento para o Geo SEO
const mainCity = site.cities[0]?.name || site.data.addressLocality;
const mainRegion = `BR-${site.data.addressRegion}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

{!noindex && <link rel="canonical" href={canonicalURL} />}

<title>{title}</title>
<meta name="description" content={description} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta name="geo.region" content={mainRegion} />
<meta name="geo.placename" content={mainCity} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={site.info.name} />
<meta property="og:locale" content="pt_BR" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

{!noindex && <SchemaOrg description={description} />}
