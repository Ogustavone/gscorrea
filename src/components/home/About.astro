---
import { Image } from "astro:assets";
import portrait from "@/assets/sobre/retrato.webp";
import Reveal from "@/components/Reveal.astro";
import { site } from "@/data/site";

// Stack agrupada por área (os itens vêm da lista e do texto anteriores)
const stack = [
  { area: "Back-end", items: "C#, .NET, Minimal APIs, EF Core, PostgreSQL" },
  { area: "Web", items: "Astro, TypeScript, Tailwind CSS" },
  { area: "Automação", items: "Python, C#" },
] as const;
---

<section
  id="sobre"
  aria-label="Sobre"
  class="scroll-mt-24 border-b border-border py-20 sm:py-24 lg:py-28"
>
  <div class="mx-auto w-full max-w-7xl px-4">
    <Reveal>
      <div class="lg:grid lg:grid-cols-12 lg:gap-x-12">
        <figure class="flex items-center gap-5 lg:col-span-4 lg:block">
          <Image
            src={portrait}
            alt="Retrato de Gustavo Correa"
            width={448}
            height={448}
            format="webp"
            quality={82}
            loading="lazy"
            decoding="async"
            class="size-36 shrink-0 rounded-control border border-border object-cover lg:size-56"
          />
          <figcaption class="lg:mt-5">
            <p class="text-body font-semibold text-text">{site.info.name}</p>
            <p class="mt-1 text-body text-text-muted">Desenvolvedor Back-end</p>
            <p class="text-body text-text-muted">
              {site.data.addressLocality}, {site.data.addressRegion}
            </p>
          </figcaption>
        </figure>

        <div class="mt-12 lg:col-span-8 lg:mt-0">
          <h2
            class="max-w-3xl font-display text-2xl font-semibold text-text sm:text-3xl lg:text-heading"
          >
            Back-end com C# e .NET: APIs e dados que continuam funcionando
            quando o volume cresce.
          </h2>

          <p class="mt-6 max-w-prose text-body text-text-muted">
            Código legível, contratos claros e o menor número possível de
            dependências.
          </p>

          <h3 class="sr-only">Stack</h3>
          <dl
            class="mt-10 max-w-3xl divide-y divide-border border-y border-border"
          >
            {
              stack.map(({ area, items }) => (
                <div class="py-4 sm:grid sm:grid-cols-[9rem_1fr] sm:gap-6">
                  <dt class="text-body text-text-muted">{area}</dt>
                  <dd class="mt-1 text-body text-text sm:mt-0">{items}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </Reveal>
  </div>
</section>