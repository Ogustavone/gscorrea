---
import { Image } from "astro:assets";
import { ArrowUpRight, ExternalLink } from "@lucide/astro";
import Modal from "@/components/Modal.astro";
import ProjectGallery from "@/components/home/ProjectGallery.astro";
import Reveal from "@/components/Reveal.astro";
import {
  getProjectCover,
  projects,
} from "@/data/projects";
import { formatIndex, projectModalId, projectTitleId } from "@/lib/project-presentation";

const projectCount = String(projects.length).padStart(2, "0");
---

<section
  id="projetos"
  aria-labelledby="projetos-titulo"
  class="scroll-mt-24 border-b border-border bg-surface-sunken py-20 sm:py-24"
>
  <div class="mx-auto w-full max-w-7xl px-4">
    <Reveal>
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
        <p class="font-mono text-meta text-text-muted uppercase">
          Portfólio — {projectCount}
        </p>

        <a
          href="https://github.com/ogustavone"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit items-center gap-2 border-b border-border pb-1 font-mono text-meta text-text-muted transition-colors duration-(--duration-base) hover:border-border-strong hover:text-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-text"
        >
          GitHub
          <span class="sr-only"> (abre em nova aba)</span>
          <ArrowUpRight class="size-3.5" aria-hidden="true" />
        </a>
      </div>

      <h2 id="projetos-titulo" class="mt-6 font-display text-heading text-text">
        Projetos
      </h2>
      <p class="mt-4 max-w-2xl text-body text-text-muted">
        Seis projetos públicos: uma API Kanban em .NET&nbsp;8, um site
        institucional no ar, um app de estoque com leitura de código de barras,
        um dashboard de cheias, automações com ESP32 e um template Astro com SEO
        automatizado.
      </p>

      <ul class="mt-12 border-t border-border">
        {
          projects.map((project, index) => {
            const modalId = projectModalId(project.slug);

            return (
              <li class="group relative border-b border-border">
                <button
                  type="button"
                  data-modal-open={modalId}
                  aria-haspopup="dialog"
                  aria-controls={modalId}
                  aria-expanded="false"
                  aria-label={`Ver detalhes do projeto ${project.title}`}
                  class="grid w-full cursor-pointer grid-cols-[2rem_minmax(0,1fr)_1.5rem] items-baseline gap-x-4 px-2 py-5 text-left transition-colors duration-(--duration-base) ease-out-expo hover:bg-text/5 focus-visible:bg-text/5 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-text motion-reduce:transition-none motion-reduce:duration-0 sm:px-3 md:grid-cols-[2.5rem_minmax(0,1fr)_4rem_8rem_2rem] md:gap-x-5 md:py-6 lg:grid-cols-[3rem_minmax(0,1fr)_4rem_9rem_10rem_2rem] lg:gap-x-8"
                >
                  <span class="font-mono text-meta text-text-muted transition-colors duration-(--duration-base) group-hover:text-primary group-focus-within:text-primary">
                    {formatIndex(index)}
                  </span>

                  <span class="min-w-0">
                    <span class="block font-display text-heading text-text sm:text-title">
                      {project.title}
                    </span>
                    <span class="mt-2 block font-mono text-meta-sm text-text-muted">
                      {project.technologies.join(" · ")}
                    </span>
                    <span class="mt-3 grid grid-cols-[4rem_minmax(0,1fr)] gap-x-3 font-mono text-meta-sm text-text-muted md:hidden">
                      <span>{project.year}</span>
                      <span>{project.kind}</span>
                    </span>
                  </span>

                  <span class="hidden self-center font-mono text-meta-sm text-text-muted md:block">
                    {project.year}
                  </span>
                  <span class="hidden self-center font-mono text-meta-sm text-text-muted md:block">
                    {project.kind}
                  </span>

                  <span class="hidden self-center lg:block" aria-hidden="true">
                    {project.preview && (
                      <Image
                        src={project.preview}
                        alt=""
                        width={320}
                        format="webp"
                        quality={80}
                        loading="lazy"
                        decoding="async"
                        class:list={[
                          "aspect-16/10 w-full rounded-control border border-border object-cover",
                          project.previewPosition === "top"
                            ? "object-top"
                            : "object-center",
                        ]}
                      />
                    )}
                  </span>

                  <ArrowUpRight
                    class="size-5 self-center justify-self-end text-text-muted transition-colors duration-(--duration-base) group-hover:text-text motion-reduce:transition-none motion-reduce:duration-0"
                    aria-hidden="true"
                  />
                </button>
              </li>
            );
          })
        }
      </ul>
    </Reveal>
  </div>

  {
    projects.map((project) => {
      const modalId = projectModalId(project.slug);
      const titleId = projectTitleId(project.slug);

      return (
        <Modal
          id={modalId}
          aria-labelledby={titleId}
          class="max-h-[calc(100dvh-1.5rem)] w-[calc(100%-1.5rem)] max-w-2xl overflow-y-auto overscroll-contain rounded-float border border-border bg-surface p-0 text-text-muted shadow-3 backdrop:bg-backdrop backdrop:backdrop-blur-xs"
        >
          <div class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-border bg-surface/95 px-5 py-3.5 backdrop-blur-md">
            <div class="min-w-0">
              <span class="font-mono text-meta-sm text-text-muted uppercase">
                Projeto
              </span>
              <h3
                id={titleId}
                class="truncate text-base font-semibold text-text"
              >
                {project.title}
              </h3>
            </div>

            <button
              type="button"
              data-modal-close
              aria-label={`Fechar detalhes do projeto ${project.title}`}
              class="flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-control border border-border bg-surface text-text-muted transition-colors hover:bg-background hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text"
            >
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
              </svg>
            </button>
          </div>

          {project.gallery ? (
            <ProjectGallery
              images={project.gallery}
              fallback={getProjectCover(project)}
              title={project.title}
            />
          ) : (
            <Image
              src={getProjectCover(project)}
              alt={`Capa do projeto ${project.title}`}
              width={800}
              height={500}
              format="webp"
              loading="lazy"
              decoding="async"
              class="aspect-16/10 w-full border-b border-border object-cover"
            />
          )}

          <div class="space-y-6 p-5 sm:p-6">
            <p class="text-body text-text-muted">{project.description}</p>

            <div>
              <h4 class="text-xs font-semibold tracking-wider text-text uppercase">
                Tecnologias
              </h4>
              <ul class="mt-3 flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <li class="rounded-control border border-border bg-background px-2.5 py-1 text-xs font-medium text-text">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex flex-col gap-2 border-t border-border pt-5 sm:flex-row sm:flex-wrap">
              {project.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    "inline-flex items-center justify-center gap-2 rounded-control border px-4 py-2.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text",
                    link.kind === "live"
                      ? "border-border-strong bg-surface-raised text-text hover:bg-background"
                      : "border-border bg-background text-text hover:border-border-strong",
                  ]}
                >
                  {link.kind === "github" ? (
                    <svg
                      class="size-4"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                      />
                    </svg>
                  ) : (
                    <ExternalLink class="size-4" aria-hidden="true" />
                  )}
                  {link.label}
                  <span class="sr-only"> (abre em nova aba)</span>
                </a>
              ))}
            </div>
          </div>
        </Modal>
      );
    })
  }
</section>
