---
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
---

<Base
  title={`Página não encontrada | ${site.info.name}`}
  description="Ops! A página que você está procurando não existe ou foi movida."
  noindex={true}
  showHeaderFooter={false}
>
  <main
    class="flex min-h-screen flex-col items-center justify-center bg-background px-4 text-center"
  >
    <div class="max-w-md w-full">
      <span class="font-mono text-sm font-semibold tracking-wider text-primary">
        404 NOT FOUND
      </span>

      <h1
        tabindex="-1"
        class="mt-2 text-5xl font-extrabold tracking-tight text-primary-text sm:text-6xl"
      >
        Página perdida<span class="text-primary">.</span>
      </h1>

      <p class="mt-4 text-sm text-secondary-text">
        O link que você seguiu pode estar quebrado ou a página foi removida.
      </p>

      <div class="mt-8 flex justify-center">
        <a
          href="/"
          class="inline-flex h-10 items-center justify-center rounded-control bg-primary px-5 text-sm font-medium text-background transition-colors duration-(--duration-fast) hover:bg-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text"
        >
          Voltar para o início
        </a>
      </div>
    </div>
  </main>
</Base>
