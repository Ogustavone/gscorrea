---
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
---

<Base
  title={`Página não encontrada | ${site.info.name}`}
  description="Ops! A página que você está procurando não existe ou foi movida."
  noindex={true}
  showHeaderFooter={false}
>
  <main
    class="flex min-h-[calc(100vh-160px)] flex-col items-center justify-center p-4 text-center"
  >
    <div class="max-w-md">
      <h1 class="text-6xl font-black text-zinc-900 dark:text-white">404</h1>
      <p class="mt-4 text-lg font-medium text-zinc-600 dark:text-zinc-400">
        Ops! A página que você está procurando não existe ou foi movida.
      </p>

      <div class="mt-8">
        <a
          href="/"
          class="inline-flex h-11 items-center justify-center rounded-lg bg-zinc-900 px-6 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100"
        >
          Voltar para o início
        </a>
      </div>
    </div>
  </main>
</Base>
